# --- Local (padrão) --------------------------------------------------------
# Nenhuma variável é obrigatória para rodar localmente: sem DATABASE_URL,
# o app cria/usa um arquivo SQLite chamado "local.db" na raiz do projeto.
DATABASE_URL=file:local.db

# --- Autenticação (NextAuth.js) --------------------------------------------
# Gere um segredo: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# --- Produção (Vercel + Turso) ---------------------------------------------
# 1. turso db create fluxo-workspace
# 2. turso db show fluxo-workspace --url          -> copie para DATABASE_URL
# 3. turso db tokens create fluxo-workspace        -> copie para DATABASE_AUTH_TOKEN
# DATABASE_URL=libsql://fluxo-workspace-xxxx.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...

# --- Upload de arquivos (Vercel Blob) --------------------------------------
# Obtenha em: https://vercel.com/dashboard/stores/blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Para desenvolvimento local, os arquivos são salvos em public/uploads/